# Sleep-EDF Expanded record SC4001 shipped with the offline benchmark, so the
# evaluator can rerun it without downloading anything. These negations must stay
# after the generic "data/" and "*.edf" rules above.
!offline_benchmark/data/
!offline_benchmark/data/SC4001E0-PSG.edf
!offline_benchmark/data/SC4001EC-Hypnogram.edf
# Generated benchmark artifacts (regenerated on every run).
offline_benchmark/outputs/
