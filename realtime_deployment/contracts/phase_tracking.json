  "phase_convention": {
    "storage_unit": "radian",
    "normalization_interval": "[-pi,pi)",
    "reference_definition": "angle(x + i*hilbert_transform(x))",
    "zero_phase_definition": "positive_peak_of_Fpz_minus_Cz",
    "theta_target_default_rad": 0.0,
    "theta_target_runtime_configurable": true,
    "target_grid_rad": [
      0.0,
      0.7853981633974483,
      1.5707963267948966,
      2.356194490192345,
      -3.141592653589793,
      -2.356194490192345,
      -1.5707963267948966,
      -0.7853981633974483
    ],
    "fields": {
      "theta_target": "user-selected physiological Hilbert target",
      "theta_internal": "target after subtracting estimator phase offset",
      "theta_command": "target after subtracting scheduler and acoustic delays",
      "phi_ref_at_acoustic_onset": "offline reference phase at measured acoustic onset"
    },
    "equations": {
      "theta_internal": "wrap(theta_target - estimator_phase_offset)",
      "theta_command": "wrap(theta_internal - 2*pi*f_hat*scheduler_prediction_horizon_s - 2*pi*f_hat*acoustic_output_delay_s)",
      "evaluation_error": "wrap(phi_ref_at_acoustic_onset - theta_target)"
    },
    "compensation_policy": {
      "estimator_phase_offset_applications": 1,
      "scheduler_prediction_horizon_applications": 1,
      "acoustic_output_delay_applications": 1,
      "duplicate_compensation_is_contract_error": true
    }
  },
